# 复制为 .env 后按实际环境填写；进程环境优先，秘密不提交或编译。
APP_NAME=type-project
APP_ENV=production
APP_DEBUG=false
APP_LISTEN=127.0.0.1
APP_PORT=9501
APP_ALLOWED_HOSTS=
APP_TRUSTED_PROXIES=
# 至少32字符的Bearer令牌由使用者提供，不自动创建生产秘密。
APP_API_TOKEN=
APP_UPLOAD_TEMP=

# PDO驱动在安装前由 configure.php 选择；运行环境不会加载其他驱动。
DB_SQLITE_FILE=var/app.sqlite
DB_HOST=127.0.0.1
# 0 表示所选MySQL 3306或PostgreSQL 5432。
DB_PORT=0
DB_DATABASE=type_project
DB_USERNAME=type_project
DB_PASSWORD=
DB_TLS_CA=
# 预算包含同一数据库的全部角色和管理连接。
APP_MAX_REPLICAS=1
APP_ROLLING_SURGE=1
APP_DATABASE_PROCESSES=1
# 每进程最大同时占用连接的线程数，含主线程和未 join 的旧代。
APP_DATABASE_THREADS=1
DB_POOL_WAITERS=64
DB_POOL_WAIT_MS=1000
DB_SERVER_BUDGET=100
DB_ADMIN_RESERVE=10
